<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>3Dミニモンハン - 村＆狩猟フィールド</title>
  <link rel="stylesheet" href="https://pyscript.net/releases/2024.11.1/core.css">
  <script type="module" src="https://pyscript.net/releases/2024.11.1/core.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
    body {
      margin: 0;
      overflow: hidden;
      background: #111;
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", sans-serif;
      color: #fff;
      touch-action: none;
    }
    #game-canvas { display: block; width: 100vw; height: 100vh; }

    /* 上部HUD */
    #hud {
      position: fixed; top: 10px; left: 10px; right: 10px;
      display: flex; justify-content: space-between; align-items: flex-start;
      pointer-events: none; z-index: 10; gap: 8px;
    }
    .panel {
      background: rgba(20, 24, 32, 0.82);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 10px; padding: 8px 12px; font-size: 13px;
      line-height: 1.5; backdrop-filter: blur(4px);
    }
    #msg {
      position: fixed; top: 82px; left: 50%; transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.78); padding: 6px 14px; border-radius: 20px;
      font-size: 13px; color: #ffd166; max-width: 90vw; text-align: center;
      z-index: 10; pointer-events: none;
    }

    /* 操作パッド */
    #pad-area {
      position: fixed; bottom: 20px; left: 20px; width: 130px; height: 130px;
      background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.25);
      border-radius: 50%; z-index: 20;
    }
    #pad-stick {
      position: absolute; top: 40px; left: 40px; width: 50px; height: 50px;
      background: rgba(255,255,255,0.55); border-radius: 50%;
      pointer-events: none;
    }

    /* 右下アクションボタン */
    #action-area {
      position: fixed; bottom: 20px; right: 20px;
      display: flex; flex-direction: column; gap: 10px; align-items: flex-end; z-index: 20;
    }
    .row-btns { display: flex; gap: 10px; }
    button {
      border: none; border-radius: 12px; font-weight: bold; color: #fff;
      padding: 12px 16px; font-size: 14px; box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    }
    button:active { transform: scale(0.95); }
    #btn-atk { background: #e05a47; padding: 16px 22px; font-size: 16px; }
    #btn-dodge { background: #2e8b57; }
    #btn-interact { background: #3a86ff; }
    #btn-weapon { background: #6c757d; font-size: 12px; padding: 8px 12px; }
  </style>
</head>
<body>
  <div id="hud">
    <div class="panel">
      <div id="area-label">📍 拠点：カムラの小村</div>
      <div id="hunter-stat">🛡️ HP: 100/100 | ⚔️ 大剣</div>
    </div>
    <div class="panel" style="pointer-events: auto; text-align: right;">
      <div id="target-stat">残モンスター: 5 頭</div>
      <button id="btn-weapon" style="margin-top:4px;">🔄 武器変更</button>
    </div>
  </div>

  <div id="msg">左下のスティックで移動！門の奥へ進むか「⛺ 村/出発」で狩猟開始</div>

  <div id="pad-area"><div id="pad-stick"></div></div>

